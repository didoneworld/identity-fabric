# Copy to .env on the server (deploy/ovh/bootstrap.sh generates the secrets for you).
# Never commit .env. Keep comments on their own line: Docker Compose does not strip
# a trailing comment after an empty value (FOO=  # note  sets FOO to "# note").

# ── Public endpoint ─────────────────────────────────────────
# DNS A/AAAA record must point at the VPS
DOMAIN=identity.example.com
# Let's Encrypt account / expiry notices
ACME_EMAIL=ops@example.com

# ── SurrealDB (internal to the compose network) ─────────────
SURREAL_USER=root
# openssl rand -hex 24
SURREAL_PASS=
SURREAL_NS=autonomyx
SURREAL_DB=identity_fabric

# ── Encryption / hashing ────────────────────────────────────
# openssl rand -hex 32  (AES-256; losing it = losing PII)
IDENTITY_FABRIC_ENC_KEY=
# openssl rand -hex 32  (changing it breaks email/phone lookups)
IDENTITY_FABRIC_HMAC_KEY=

# ── Caller auth ─────────────────────────────────────────────
# operator mode for internal agents (X-Agent-Secret header)
AUTONOMYX_AGENT_SECRET=
# e.g. https://your-tenant.logto.app
LOGTO_ENDPOINT=
# API resource indicator registered in Logto
LOGTO_AUDIENCE=
# JWT claim holding the caller's tenant
TENANT_CLAIM=tenant_id
# used when a token has no tenant claim
DEFAULT_TENANT_ID=

# ── Provider connectors (only the ones you use) ─────────────
LOGTO_DOMAIN=
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
OKTA_DOMAIN=
OKTA_API_TOKEN=
AUTH0_DOMAIN=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
PING_ENV_ID=
PING_CLIENT_ID=
PING_CLIENT_SECRET=
PING_REGION=NorthAmerica
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# name=https://issuer,name2=https://issuer2
CUSTOM_OIDC_PROVIDERS=

# ── Tuning ──────────────────────────────────────────────────
MAX_EDGE_DEPTH=3
ENRICH_TTL_HOURS=24

# ── Image (set by the deploy workflow) ──────────────────────
IMAGE=ghcr.io/didoneworld/identity-fabric
IMAGE_TAG=latest
