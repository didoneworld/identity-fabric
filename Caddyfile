	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy api:8080 {
		health_uri /healthz
		health_interval 5s
		# ride out API restarts during deploys instead of returning 503
		lb_try_duration 10s
	}
}
